Name:           mm
Version:        @VERSION@
Release:        3%{?dist}
Summary:        Digital version of the Mastermind game

License:        AGPL3.0-only
URL:            https://github.com/Zedran/mm
Vendor:         Wojciech Głąb (github.com/Zedran)
Group:          Unspecified
Source0:        %{name}-%{version}.tar.gz

BuildRequires:  gcc-c++
BuildRequires:  cmake
BuildRequires:  libXcursor-devel
BuildRequires:  libXrandr-devel
BuildRequires:  libXi-devel
BuildRequires:  mesa-libGL-devel
BuildRequires:  systemd-devel
BuildRequires:  mbedtls-devel
BuildRequires:  libssh2-devel
BuildRequires:  harfbuzz-devel
BuildRequires:  freetype-devel
BuildRequires:  libvorbis-devel
BuildRequires:  flac-devel

%global debug_package %{nil}

%description
%{summary}

%prep
%autosetup

%build
%cmake -DCMAKE_BUILD_TYPE=Release -DMM_VERSION=v%{version}
%cmake_build

%install
%cmake_install

%files
%license %{_datadir}/mm/LICENSE
%license %{_datadir}/mm/NOTICE.md
%license %{_datadir}/mm/docs/licenses/Inter.txt
%license %{_datadir}/mm/docs/licenses/SFML.txt
%doc     %{_datadir}/mm/README.md
%{_bindir}/mm
%{_datadir}/mm/assets/InterVariable.ttf
%{_datadir}/mm/assets/mm.png
%{_datadir}/mm/assets/mm.svg
%{_datadir}/applications/mm.desktop

%changelog
* Sat Aug 01 2026 Zedran <17592740+Zedran@users.noreply.github.com> - v0.2.2-3
- Add missing build requirements

* Fri Jul 31 2026 Zedran <17592740+Zedran@users.noreply.github.com> - 0.2.1-2
- Allow the build system to set flags for compiler and linker

* Thu Jul 30 2026 Zedran <17592740+Zedran@users.noreply.github.com>
- Initial package specification
